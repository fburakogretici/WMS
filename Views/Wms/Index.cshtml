@model IEnumerable<IndexWMSProject.Models.B2BOrder>
@{
    ViewData["Title"] = "WMS Dashboard";
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                    <i class="fa-solid fa-cart-shopping fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Bekleyen Siparişler</h6>
                    <h3 class="mb-0 fw-bold">@Model.Count(o => o.Status != "Shipped")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                    <i class="fa-solid fa-truck-fast fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Sevk Edilenler (Bugün)</h6>
                    <h3 class="mb-0 fw-bold">@Model.Count(o => o.Status == "Shipped")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                    <i class="fa-solid fa-box-open fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Toplanacak Ürün Adedi</h6>
                    <h3 class="mb-0 fw-bold">@Model.Where(o => o.Status != "Shipped").SelectMany(o => o.Items).Where(i => !i.IsPicked).Sum(i => i.Quantity)</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
        <h5 class="fw-bold mb-0"><i class="fa-solid fa-list-check me-2 text-primary"></i>B2B Sipariş Listesi</h5>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light text-muted">
                    <tr>
                        <th class="fw-semibold rounded-start">Sipariş No</th>
                        <th class="fw-semibold">Müşteri</th>
                        <th class="fw-semibold">Tarih</th>
                        <th class="fw-semibold">Durum</th>
                        <th class="fw-semibold text-end rounded-end">İşlem (RF Simülasyonu)</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-medium text-dark">@order.OrderNumber</td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-clock me-1"></i> Bekliyor</span>
                                }
                                else if (order.Status == "Processing")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill"><i class="fa-solid fa-spinner fa-spin me-1"></i> Toplanıyor</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill"><i class="fa-solid fa-check me-1"></i> Sevk Edildi</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="RfTerminal" asp-route-orderId="@order.Id" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                    <i class="fa-solid fa-barcode me-1"></i> RF Ekranı
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
